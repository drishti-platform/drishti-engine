<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.engine</groupId>
    <artifactId>engine-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>engine-sample</artifactId>
  <name>Drishti Engine: engine-sample (the example engines, delivered as one JAR)</name>
  <description>Two small deterministic engines in one JAR, built the way any engine is: wmean (the specification's worked example) and group-totals (read as the caller, grouped at the source). engine-api and drishti-tools are provided by the host; nothing else. Its kit runs on the packaged JAR in this build.</description>
  <properties>
    <automatic.module.name>com.ash.sample.engines</automatic.module.name>
    <!-- the engine API this JAR is compiled against: the manifest says it, the descriptors' api must equal it (the kit checks) -->
    <engine.api.built>0.1</engine.api.built>
  </properties>
  <dependencies>
    <!-- provided: the host's, shared and parent-first; never inside the engine JAR -->
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId><scope>provided</scope></dependency>
    <!-- the kit and its harness, for this build's own tests only -->
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-tck</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Engine-Api>${engine.api.built}</Engine-Api>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- the kit on the packaged JAR, as a host will meet it, and the drop-in proof: after package, before install -->
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
        <configuration>
          <tempDir>tmp</tempDir>
          <argLine>-Djava.io.tmpdir=${project.build.directory}/tmp</argLine>
          <systemPropertyVariables>
            <engine.jar>${project.build.directory}/${project.build.finalName}.jar</engine.jar>
            <engine.cases>${project.basedir}/tck/cases</engine.cases>
            <engine.kit.out>${project.build.directory}/kit</engine.kit.out>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
