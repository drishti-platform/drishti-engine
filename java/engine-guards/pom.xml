<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.engine</groupId>
    <artifactId>engine-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>engine-guards</artifactId>
  <name>Drishti Engine: the repository's guards (engine-api has no dependency, names no host, public surface, no mutable statics, header, file cap, launchers)</name>
  <properties>
    <automatic.module.name>com.ash.engine.guards</automatic.module.name>
    <engine.api.surface.write>false</engine.api.surface.write>
  </properties>
  <dependencies>
    <!-- the shared guard kit (header and line cap, API surface), published by drishti-tools as a test jar -->
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-guards</artifactId><type>test-jar</type><scope>test</scope></dependency>
    <!-- test scope: the surface and statics guards load the modules' compiled classes; the kit's class-file reader -->
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-host</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-tck</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <engine.api.surface.write>${engine.api.surface.write}</engine.api.surface.write>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
