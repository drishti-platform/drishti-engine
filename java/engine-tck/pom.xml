<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.engine</groupId>
    <artifactId>engine-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>engine-tck</artifactId>
  <name>Drishti Engine: engine-tck (the engine kit)</name>
  <description>The kit: cases as data, the laws derived from every case, the delivery group and static scan, explanations recomputed by Rachana's evaluator, workbooks recalculated by Apache POI, the lifecycle, the gates, the certificate, the benchmark run, and the JUnit harness. Also built as one runnable JAR (classifier cli) that needs a JDK only.</description>
  <properties>
    <automatic.module.name>com.ash.engine.tck</automatic.module.name>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-host</artifactId></dependency>
    <!-- the platform libraries the kit provides to the JAR it certifies, as a host does -->
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId></dependency>
    <!-- the oracles: Rachana's reference evaluator, and a spreadsheet engine the author did not write -->
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-core</artifactId></dependency>
    <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory><filtering>true</filtering></resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>cli</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.ash.engine.tck.Main</mainClass>
                  <manifestEntries><Multi-Release>true</Multi-Release></manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude><exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
