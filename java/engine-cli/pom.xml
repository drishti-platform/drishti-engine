<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.engine</groupId>
    <artifactId>engine-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>engine-cli</artifactId>
  <name>Drishti Engine: engine-cli</name>
  <description>Any engine with no host: a day of JSONL files in, its answer's tables as JSONL, the answer's status and stamp, an explanation and the formula workbook out. The third host of the specification (with the kit and Drishti). Also built as one runnable JAR (classifier cli).</description>
  <properties>
    <automatic.module.name>com.ash.engine.cli</automatic.module.name>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-host</artifactId></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-inputs-files</artifactId></dependency>
    <!-- the platform library the command provides to the engine it runs, as a host does -->
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory><filtering>true</filtering></resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>cli</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.ash.engine.cli.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
